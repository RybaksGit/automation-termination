{
  "name": "e2e-scale-framework",
  "version": "1.0.0",
  "description": "Production-grade Playwright + TypeScript automation framework",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test framework/tests/api",
    "test:e2e": "playwright test framework/tests/e2e",
    "test:visual": "playwright test framework/tests/visual",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "report:allure": "allure generate framework/reporters/allure/results --clean -o framework/reporters/allure/report && allure open framework/reporters/allure/report",
    "lint": "eslint framework --max-warnings 0",
    "lint:fix": "eslint framework --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "clean": "tsx framework/scripts/clean.ts",
    "setup:env": "tsx framework/scripts/setup-env.ts",
    "generate:data": "tsx framework/scripts/generate-data.ts",
    "merge:reports": "tsx framework/scripts/merge-reports.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.0",
    "allure-playwright": "^3.2.2",
    "dotenv": "^16.5.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.1.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.32.0",
    "zod": "^3.24.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
