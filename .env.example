# Environment: local | stage | prod
ENV=local

# Application URLs
BASE_URL=https://demo.playwright.dev/todomvc/
API_BASE_URL=https://jsonplaceholder.typicode.com

# Auth (example — override per environment)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=changeme

# Playwright execution
HEADLESS=true
WORKERS=
RETRIES=0
TIMEOUT=30000

# Reporting
ALLURE_RESULTS_DIR=framework/reporters/allure/results
ENABLE_ALLURE=true

# Feature flags
FEATURE_NEW_CHECKOUT=false
